<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!--
		The Spring Boot parent POM pins compatible versions for every Spring/Boot library,
		so the dependencies below don't need <version> tags. (At JPMC, Photon Boot plays this role.)
	-->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<groupId>com.enrollment</groupId>
	<artifactId>enrollment-service</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>enrollment-service</name>
	<description>Practice Enrollment service: REST + gRPC, Cassandra, Kafka, Kubernetes</description>

	<properties>
		<java.version>25</java.version>
	</properties>

	<dependencies>
		<!-- Web MVC: embedded Tomcat + @RestController + JSON (Jackson) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!-- Bean Validation: @NotBlank, @Past, etc. on request DTOs -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- Actuator: /actuator/health, /actuator/metrics, ... -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!-- Security: every endpoint is locked down by default; see SecurityConfig -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!-- Cache: @Cacheable / @CacheEvict backed by a simple in-memory cache -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-cache</artifactId>
		</dependency>

		<!--
			Retry: no dependency needed. Spring Framework 7 (under Boot 4) has @Retryable built in
			(org.springframework.resilience.annotation). We switch it on in Phase 2 for the Cassandra write.
		-->

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Packages the app as a runnable "fat jar" and adds `mvn spring-boot:run` -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
